{
	"name": "@pie-lab/pie-chat",
	"version": "0.1.6",
	"private": true,
	"type": "module",
	"description": "Next.js pie-lab chat app based on the pi-chat source",
	"pi": {
		"extensions": [
			"./extension/index.ts"
		]
	},
	"scripts": {
		"dev": "next dev -H 127.0.0.1 -p 4877",
		"build": "npm run check:bridge && next build",
		"start": "next start -H 127.0.0.1 -p 4877",
		"lint": "eslint",
		"check": "eslint && npm run build",
		"check:bridge": "tsc -p tsconfig.bridge.json --noEmit"
	},
	"dependencies": {
		"@earendil-works/gondolin": "^0.7.0",
		"@pie-lab/coding-agent": "^0.1.2",
		"@pie-lab/tui": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"discord.js": "^14.26.4",
		"lucide-react": "^1.16.0",
		"next": "16.2.6",
		"pretendard": "^1.3.9",
		"radix-ui": "^1.4.3",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "10.1.0",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remend": "^1.3.0",
		"shadcn": "^4.8.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"typebox": "1.1.38",
		"unified": "11.0.5"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.6",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
