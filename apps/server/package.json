{
	"name": "@pie-lab/server",
	"version": "0.2.1",
	"private": true,
	"type": "module",
	"description": "pie-lab local API server",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"test": "vitest --run",
		"build": "tsgo -p tsconfig.build.json",
		"check": "tsgo -p tsconfig.build.json --noEmit"
	},
	"dependencies": {
		"@pie-lab/ai": "^0.2.1",
		"@pie-lab/coding-agent": "^0.2.1",
		"@pie-lab/router": "^0.2.1",
		"@pie-lab/shared": "^0.2.1",
		"@pie-lab/storage": "^0.2.1",
		"undici": "^8.5.0"
	}
}
