{
	"name": "@pie-lab/shared",
	"version": "0.1.6",
	"type": "module",
	"description": "Shared metadata and utilities for pie-lab",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"clean": "shx rm -rf dist"
	},
	"dependencies": {
		"@pie-lab/router": "^0.1.6",
		"@pie-lab/storage": "^0.1.6",
		"undici": "^8.3.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jikime/pie-lab.git",
		"directory": "packages/shared"
	},
	"homepage": "https://github.com/jikime/pie-lab#readme",
	"bugs": {
		"url": "https://github.com/jikime/pie-lab/issues"
	}
}
