{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@pie-lab/ai": ["./packages/ai/src/index.ts"],
			"@pie-lab/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@pie-lab/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@pie-lab/ai/dist/*": ["./packages/ai/src/*"],
			"@pie-lab/agent-core": ["./packages/agent/src/index.ts"],
			"@pie-lab/agent-core/*": ["./packages/agent/src/*"],
			"@pie-lab/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@pie-lab/coding-agent/auth-storage": ["./packages/coding-agent/src/core/auth-storage.ts"],
			"@pie-lab/coding-agent/config": ["./packages/coding-agent/src/config.ts"],
			"@pie-lab/coding-agent/model-registry": ["./packages/coding-agent/src/core/model-registry.ts"],
			"@pie-lab/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@pie-lab/coding-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@pie-lab/tui": ["./packages/tui/src/index.ts"],
			"@pie-lab/tui/*": ["./packages/tui/src/*"],
			"@pie-lab/router": ["./packages/router/src/index.ts"],
			"@pie-lab/router/*": ["./packages/router/src/*"],
			"@pie-lab/storage": ["./packages/storage/src/index.ts"],
			"@pie-lab/storage/*": ["./packages/storage/src/*"],
			"@pie-lab/shared": ["./packages/shared/src/index.ts"],
			"@pie-lab/shared/*": ["./packages/shared/src/*"],
			"@pie-lab/hashline": ["./packages/hashline/src/index.ts"],
			"@pie-lab/hashline/*": ["./packages/hashline/src/*"]
		}
	},
	"include": [
		"apps/server/src/**/*",
		"apps/server/test/**/*",
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
